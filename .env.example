# ============================================================
# 환경변수 샘플
#
# 이 파일을 .env 로 복사해서 값만 채운다.
#   cp .env.example .env
#
# .env 는 .gitignore 에 있어 커밋되지 않는다. 이 파일만 커밋한다.
# 실제 운영에서는 .env 파일을 쓰지 않는다. 아래 [저장 위치]를 따른다.
#
# [저장 위치]
#   ACTIONS  = GitHub 저장소 Settings > Secrets and variables > Actions
#   VERCEL   = Vercel 프로젝트 Settings > Environment Variables
#   LOCAL    = 내 PC에서 배치를 시험 실행할 때만 쓰는 .env
#
# 값에 따옴표를 붙이지 않는다. 값 안에 # 을 쓰지 않는다.
# ============================================================


# ------------------------------------------------------------
# 1. 텔레그램  [ACTIONS, VERCEL, LOCAL]
#    발급: docs/api-keys.md 1번. BotFather 에서 /newbot
# ------------------------------------------------------------

# BotFather 가 준 토큰. 숫자:영문자 형태
TELEGRAM_BOT_TOKEN=

# 내 대화방 번호. 봇에게 메시지를 한 번 보낸 뒤 스크립트가 찾아 채운다.
# 직접 찾으려면 https://api.telegram.org/bot<토큰>/getUpdates 에서 chat.id 확인
TELEGRAM_CHAT_ID=
# 텔레그램 질의응답 웹훅의 비밀 머리글 값 (Vercel 만, docs/telegram-qa.md). 16자 이상 영문·숫자·_·-. 비우면 질의응답이 꺼진다
TELEGRAM_WEBHOOK_SECRET=


# ------------------------------------------------------------
# 2. 데이터베이스 (Turso)  [ACTIONS, VERCEL, LOCAL]
#    무료 플랜, 카드 불필요. 10일간 활동이 없으면 보관 상태로 전환된다
# ------------------------------------------------------------

# libsql://이름-계정.turso.io 형태
TURSO_DATABASE_URL=

TURSO_AUTH_TOKEN=

# 어느 DB 를 쓰는가 (docs/infra.md 25절). 비우면 turso. auto 면 Turso 가 살아 있는지 보고 고른다(25.12)
#   Turso 가 월 한도로 막힌 동안 d1 으로 옮겨 운영한다. 둘 다 SQLite 라 질의·마이그레이션은 같다.
DB_BACKEND=

# Cloudflare D1 (무료, 카드 불필요 [확인필요: 가입 화면])
#   ACCOUNT_ID   대시보드 주소 dash.cloudflare.com/<여기>/... 또는 계정 홈 오른쪽
#   DATABASE_ID  D1 데이터베이스 상세 화면
#   API_TOKEN    My Profile → API Tokens → Create Token → 권한 Account · D1 · Edit
D1_ACCOUNT_ID=
D1_DATABASE_ID=
D1_API_TOKEN=


# ------------------------------------------------------------
# 3. 웹앱 인증  [VERCEL, web/.env.local]
#
#    로그인 없이는 어떤 데이터도 반환하지 않는다.
#    한국거래소 약관이 데이터의 제3자 제공을 금지하므로 인증은 선택이 아니다.
#
#    사용자가 한 명이라 회원가입도 비밀번호 재설정도 없다.
#    비밀번호 하나로 들어오고 서명한 쿠키로 30일 유지한다.
# ------------------------------------------------------------

# 세션 서명용 임의 문자열. 이 값을 바꾸면 모든 로그인이 풀린다.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# 로그인 비밀번호. 4자 미만이면 앱이 거부한다(시도 횟수 제한과 함께 — web/lib/auth.ts MIN_PASSWORD_LENGTH, docs/infra.md 25.594).
# 짧을수록 시도 제한 하나에 기대게 된다. 아래처럼 길게 만들 것을 권한다.
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
APP_PASSWORD=


# ------------------------------------------------------------
# 4. 외부 크론 호출용 토큰  [VERCEL, cron-job.org]
#    cron-job.org 가 부르는 경로는 로그인 대신 이 토큰으로 보호한다
#    요청 헤더에 담아 보낸다. 주소 뒤에 붙이지 않는다
# ------------------------------------------------------------

# 임의 문자열. openssl rand -hex 32
CRON_SECRET=


# ------------------------------------------------------------
# 4-1. 웹앱 주소  [ACTIONS(변수), LOCAL]
#    텔레그램 아침 리포트의 종목 줄에 "매매 입력" 링크를 붙인다 (docs/infra.md 25.944).
#    비밀이 아니라 Actions 의 Variables 에 APP_URL 로 둔다. 비우면 링크 없이 보낸다
# ------------------------------------------------------------

# 끝에 / 없이. 예: https://stock-manager-xxx.vercel.app
APP_URL=


# ------------------------------------------------------------
# 5. 웹에서 배치를 깨울 때 쓰는 토큰  [VERCEL]
#    백테스트 실행 요청(Step 16)과 포트폴리오 재계산(Step 12)에 쓴다
#    이 저장소에만 쓰는 fine-grained 토큰으로 두고, 권한은 둘 중 하나면 된다
#      Actions: read and write    → workflow_dispatch (파라미터를 그대로 넘긴다. 웹이 먼저 시도)
#      Contents: read and write   → repository_dispatch (client_payload 로 넘긴다)
#    웹은 앞엣것을 먼저 부르고 403·404 면 뒤엣것을 부른다 (docs/backtest.md 8.1)
#    없으면 화면이 이유를 보여 주고, Actions 에서 직접 돌리면 된다
# ------------------------------------------------------------

GH_DISPATCH_TOKEN=
GH_REPO=사용자명/저장소명


# ------------------------------------------------------------
# 6. DART 전자공시  [ACTIONS, LOCAL, VERCEL]   Step 4
#    VERCEL 에도 넣는다 — 장중 경로가 보유 종목 신규 공시(트리거 e)를 DART 로 본다. 없으면 그 알림이 꺼진다 (docs/infra.md 25.720)
#    발급: docs/api-keys.md 2번. 개인회원은 즉시 발급
#    무료 한도 일 20,000건
# ------------------------------------------------------------

DART_API_KEY=


# ------------------------------------------------------------
# 7. KRX 정보데이터시스템  [ACTIONS, LOCAL]   Step 3
#    국내 시세·종목마스터·업종의 1순위 경로
#    발급: docs/api-keys.md 3번
#    인증키를 받은 뒤 쓰려는 API 마다 이용신청을 따로 해야 한다
#    무료 한도 키당 일 10,000회. 비상업 전용, 제3자 제공 금지
#    인증키 유효기간 1년. 12개월 미사용 시 삭제된다
# ------------------------------------------------------------

KRX_API_KEY=


# ------------------------------------------------------------
# 8. 한국투자증권 KIS Developers   선택 [ACTIONS, VERCEL]
#
#    2026-10-07 사용자가 발급해 넣었다 — 클라우드 호출 확인 중 (scripts/probe_kis.py, infra 25.983).
#    계좌번호는 넣지 않는다(시세 조회에는 필요 없고 주문 API 는 부르지 않는다).
#    2026-09-16 에 선택 항목으로 내렸다.
#    이 API 가 주는 것은 장중 실시간 시세와 공식 휴장일 조회 둘뿐이고
#    나머지 국내 데이터는 KRX 와 DART 로 전부 덮인다.
#    실계좌가 필요한 데다 클라우드 IP 에서 호출되는지가 확인되지 않았다.
#
#    장중 정확도가 아쉬워지면 그때 붙인다. 어댑터 파일 하나를 더하면 된다.
#    조사한 조건은 docs/data-sources.md 3번에 있다
# ------------------------------------------------------------

KIS_APP_KEY=
KIS_APP_SECRET=
# KIS_ENV=prod


# ------------------------------------------------------------
# 9. 무위험수익률  [지금은 아무 데도 안 쓴다]
#
#    **둘 다 비워 두세요.** 무위험수익률은 설정 화면에서 손으로 넣습니다
#    (설정 → 무위험수익률, 국내·미국 각각 %). 안 넣으면 샤프·소르티노가
#    비고 설정 화면이 "빠진 값" 으로 알려 줍니다.
#
#    아래 두 칸을 채워도 **아무 일도 일어나지 않습니다.** 받아 오는 코드가
#    없습니다 (2026-09-23 확인, docs/infra.md 25.160). 칸만 남겨 둔 이유는
#    붙일 때 무엇이 필요한지 잊지 않기 위해서입니다.
# ------------------------------------------------------------

# 미국 3개월 국채. 발급: docs/api-keys.md 6번
# 붙인다면 일별 DTB3, 월별 TB3MS. 그때 화면에 고지 문구가 필요하다
FRED_API_KEY=

# 한국은행 ECOS. 발급: docs/api-keys.md 7번
# 무료 한도가 확인되지 않아 **사용 보류** (CLAUDE.md 비용 규칙). 출처 표시 의무가 있다
ECOS_API_KEY=


# SEC EDGAR (미국 주식수·재무)  [ACTIONS, LOCAL]
# 키는 없지만 연락처(이메일)가 든 User-Agent 가 필수다. 없으면 403. docs/data-sources.md 14절
# 형태: 앱이름 용도 본인이메일
SEC_USER_AGENT=

# ------------------------------------------------------------
# 10. 네이버 검색 API   보류
#     레거시 검색 API 가 종료 절차에 들어간 것으로 보인다.
#     신규 등록이 되는지 확인 전까지 쓰지 않는다.
#     국내 뉴스는 언론사 공식 RSS 로 전환을 검토 중이다
# ------------------------------------------------------------

# NAVER_CLIENT_ID=
# NAVER_CLIENT_SECRET=


# ------------------------------------------------------------
# 11. 실행 옵션  [ACTIONS, LOCAL]
# ------------------------------------------------------------

# 1 이면 네트워크를 타지 않고 tests/fixtures 를 읽는다.
# 테스트는 항상 이 모드로 돈다. API 키 없이 돌아가야 한다
OFFLINE_MODE=0

# DEBUG, INFO, WARNING
LOG_LEVEL=INFO

# 배치가 한 종목에서 실패해도 전체를 멈추지 않을지 여부
CONTINUE_ON_ITEM_ERROR=1

# 미국 일봉 수집에서 한 요청에 묶을 심볼 수. 비우면 200 을 쓴다.
#
# 조각 수가 곧 요청 수이자 시간이다. 2026-09-16 실측으로 5,684종목을
# 200개씩 29조각으로 나눠 16분 40초가 걸렸다(docs/infra.md 12절).
# 키우면 시간이 줄지만 야후의 요청당 심볼 상한은 공개돼 있지 않다.
# 실측해 보고 결정한다. 확인 전에는 비워 둔다.
YF_CHUNK_SYMBOLS=

# 미국 일봉을 며칠치 받을지. 비우면 10.
#
# 수정주가(adj_close)는 배당·분할이 생기면 과거 값이 전부 다시 조정된다.
# 매일 10일치만 덮어쓰면 최근 행과 옛 행의 조정 기준이 어긋난다. 일관되게
# 맞추려면 전 구간을 한 번에 받는다 (예: 1300). docs/infra.md 15절.
US_LOOKBACK_DAYS=
